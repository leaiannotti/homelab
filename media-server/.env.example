# ── Docker ──────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Pacific/Auckland
DATA_ROOT=/mnt/ai-data/data

# ── Plex ───────────────────────────────────────────
# Get claim token at: https://plex.tv/claim
PLEX_CLAIM=

# ── VPN (gluetun, ProtonVPN WireGuard) ─────────────
# Required: docker compose fails without it
WIREGUARD_PRIVATE_KEY=

# ── Telegram Bot ───────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (get via @userinfobot)
TELEGRAM_ADMIN_ID=
# Optional static users (comma-separated IDs). Prefer /adduser from the bot.
TELEGRAM_EXTRA_USERS=

# ── TMDB API ───────────────────────────────────────
# Free at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Radarr ─────────────────────────────────────────
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# ── Sonarr ─────────────────────────────────────────
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# ── qBittorrent ────────────────────────────────────
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=
