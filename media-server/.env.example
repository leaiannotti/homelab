# ── Docker ──────────────────────────────────────────
PUID=1000
PGID=1000
TZ=America/Argentina/Buenos_Aires
DATA_ROOT=/data

# ── Plex ───────────────────────────────────────────
# Get claim token at: https://plex.tv/claim
PLEX_CLAIM=

# ── Telegram Bot ───────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (get via @userinfobot)
TELEGRAM_ADMIN_ID=
# Additional users (comma-separated IDs, get via @userinfobot)
TELEGRAM_EXTRA_USERS=

# ── TMDB API ───────────────────────────────────────
# Free at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Radarr ─────────────────────────────────────────
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# ── Sonarr ─────────────────────────────────────────
SONARR_URL=http://localhost:8989
SONARR_API_KEY=
