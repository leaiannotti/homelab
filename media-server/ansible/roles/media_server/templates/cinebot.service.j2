[Unit]
Description=CineBot Telegram media server bot
After=network.target docker.service

[Service]
Type=simple
User={{ ansible_user }}
WorkingDirectory={{ media_server_dir }}
ExecStart={{ media_server_dir }}/bot/venv/bin/python -m bot.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
